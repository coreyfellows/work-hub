# work-hub's ticket-workflow settings. setup.sh copies this to work-hub's config dir as ticket-workflow.env
# (<work-hub config dir>/ticket-workflow.env, or $WORK_HUB_TW_CONFIG); fill in what applies to you.
# A standalone ticket-workflow setup's ~/.config/ticket-workflow/config.env is read too; values here win.
# Every line starts commented out, so a value you leave alone still comes from that file (or the default). Everything is optional; unset values use the defaults shown.
# This file is sourced by bash, so use VAR="value" with no spaces around '='.

# --- Worktrees ---
# Worktrees go in $TW_WORKTREES_ROOT/<repo-name>/<TICKET or short-description>.
# TW_WORKTREES_ROOT="$HOME/worktrees"
# Run `pnpm install --frozen-lockfile` in new worktrees that have a pnpm-lock.yaml.
# TW_PNPM_INSTALL=1

# --- Jira site ---
# Used for Jira links in ticket notes. Leave empty to skip Jira entirely.
# TW_JIRA_BASE_URL=""            # e.g. https://example.atlassian.net

# --- Jira defaults (ticket-defaults skill) ---
# TW_JIRA_ACCOUNT_ID=""          # your Atlassian accountId (Jira profile URL, or the myself API)
# TW_JIRA_PROJECT=""             # e.g. ABC
# TW_JIRA_BOARD_ID=""            # the board whose active sprint new tickets go in
# TW_JIRA_SPRINT_PREFIX=""       # optional, e.g. "Team Sprint" to match sprint names
# TW_JIRA_SPRINT_FIELD="customfield_10020"
# TW_JIRA_POINTS_FIELD=""        # e.g. customfield_10016; looked up by name if empty
# TW_JIRA_IN_PROGRESS_TRANSITION=""   # transition id; looked up by name if empty
# TW_JIRA_NO_PRIORITY=""         # the project's "unset" priority name, if it has one (e.g. TBD)

# --- Ticket notes (SilverBullet, run by work-hub's notes plugin) ---
# TW_NOTES_DIR="$HOME/notes"
# Where work-hub serves the notes: a path on its own origin, or a full URL.
# TW_NOTES_URL="/notes"

# --- Misc ---
# Add the ticket-workflow policy to the context of every session work-hub starts (0 to turn off).
# TW_INJECT_POLICY=1
