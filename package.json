{
  "name": "work-hub",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "node scripts/env-run.ts WORK_HUB_DEV=1 -- node --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node scripts/env-run.ts NODE_ENV=production -- node server/index.ts",
    "check-plugin": "node scripts/check-plugin.ts",
    "pretypecheck": "node scripts/gen-plugins.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/gen-plugins.ts",
    "test": "node --test \"server/**/*.test.ts\" \"web/src/**/*.test.ts\" \"plugins/**/*.test.ts\" \"builtin/**/*.test.ts\" \"scripts/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/node-ws": "^1.3.1",
    "@novnc/novnc": "1.7.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.16",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
